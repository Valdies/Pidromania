local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer

-- ==============================================================================
-- === GUI BUILDING ===
-- ==============================================================================
local screenGuiMain = nil

local function rebuildGUI()
	if screenGuiMain then
		screenGuiMain:Destroy()
	end

	screenGuiMain = Instance.new("ScreenGui")
	screenGuiMain.Name = "PidromaniaHub_Loader"
	screenGuiMain.ResetOnSpawn = false
	screenGuiMain.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGuiMain.DisplayOrder = 10000 
	screenGuiMain.IgnoreGuiInset = true 
	screenGuiMain.Parent = player:WaitForChild("PlayerGui")

	-- Блокер ввода (прозрачный слой на весь экран)
	local blocker = Instance.new("Frame")
	blocker.Size = UDim2.new(1, 0, 1, 0)
	blocker.BackgroundTransparency = 1
	blocker.ZIndex = 100
	blocker.Parent = screenGuiMain

	local mainFrame = Instance.new("Frame")
	-- Чистые значения: 1200x750
	mainFrame.Size = UDim2.new(0, 1200, 0, 750)
	
	-- Центрирование со смещением вниз на 36px
	mainFrame.Position = UDim2.new(0.5, -600, 0.5, -346) -- -375 (половина высоты) + 36 = -339
	
	mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	mainFrame.BorderSizePixel = 0
	mainFrame.Active = true
	mainFrame.ZIndex = 200
	mainFrame.Parent = screenGuiMain

	local mainFrameCorner = Instance.new("UICorner")
	mainFrameCorner.CornerRadius = UDim.new(0, 15) -- Чистое значение 15
	mainFrameCorner.Parent = mainFrame

	-- 1. Центральный текст: "Pidromania Airlinies"
	local centerLabel = Instance.new("TextLabel")
	centerLabel.Name = "TitleLabel"
	centerLabel.Text = "Pidromania Airlinies"
	centerLabel.Size = UDim2.new(1, 0, 0.4, 0)
	centerLabel.Position = UDim2.new(0, 0, 0.1, 0)
	centerLabel.BackgroundTransparency = 1
	centerLabel.TextColor3 = Color3.fromRGB(200, 200, 255)
	centerLabel.Font = Enum.Font.GothamBold
	centerLabel.TextSize = 54 -- Чистое значение 54
	centerLabel.TextXAlignment = Enum.TextXAlignment.Center
	centerLabel.TextYAlignment = Enum.TextYAlignment.Center
	centerLabel.ZIndex = 201
	centerLabel.Parent = mainFrame

	-- 2. Текст "Идет загрузка..."
	local loadingLabel = Instance.new("TextLabel")
	loadingLabel.Name = "LoadingLabel"
	loadingLabel.Text = "Идет загрузка..."
	loadingLabel.Size = UDim2.new(1, 0, 0.2, 0)
	loadingLabel.Position = UDim2.new(0, 0, 0.45, 0)
	loadingLabel.BackgroundTransparency = 1
	loadingLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
	loadingLabel.Font = Enum.Font.Gotham
	loadingLabel.TextSize = 36 -- Чистое значение 36
	loadingLabel.TextXAlignment = Enum.TextXAlignment.Center
	loadingLabel.TextYAlignment = Enum.TextYAlignment.Center
	loadingLabel.ZIndex = 201
	loadingLabel.Parent = mainFrame

	-- 3. Счетчик
	local counterLabel = Instance.new("TextLabel")
	counterLabel.Name = "CounterLabel"
	counterLabel.Text = "7"
	counterLabel.Size = UDim2.new(1, 0, 0.2, 0)
	counterLabel.Position = UDim2.new(0, 0, 0.65, 0)
	counterLabel.BackgroundTransparency = 1
	counterLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	counterLabel.Font = Enum.Font.GothamBold
	counterLabel.TextSize = 60 -- Чистое значение 60
	counterLabel.TextXAlignment = Enum.TextXAlignment.Center
	counterLabel.TextYAlignment = Enum.TextYAlignment.Center
	counterLabel.ZIndex = 201
	counterLabel.Parent = mainFrame

	-- Логика обратного отсчета
	task.spawn(function()
		for i = 6, 0, -1 do
			counterLabel.Text = tostring(i)
			task.wait(1) 
		end

		-- Анимация исчезновения
		local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
		
		local tweenBg = TweenService:Create(mainFrame, tweenInfo, { BackgroundTransparency = 1 })
		tweenBg:Play()
		
		local textGoal = { TextTransparency = 1 }
		TweenService:Create(centerLabel, tweenInfo, textGoal):Play()
		TweenService:Create(loadingLabel, tweenInfo, textGoal):Play()
		TweenService:Create(counterLabel, tweenInfo, textGoal):Play()
		
		TweenService:Create(blocker, tweenInfo, { BackgroundTransparency = 1 }):Play()

		task.wait(0.5)
		screenGuiMain:Destroy()
	end)
end

rebuildGUI()
